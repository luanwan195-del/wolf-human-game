{
  "rules": {
    "rooms": {
      "$code": {
        "public": {
          ".read": "auth != null",
          ".write": false
        },
        "players": {
          ".read": "auth != null",
          "$uid": {
            ".write": false
          }
        },
        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        },
        "chat": {
          "public": {
            ".read": "auth != null",
            ".write": false
          },
          "wolves": {
            ".read": "auth != null && root.child('rooms').child($code).child('private').child(auth.uid).child('role').val() === 'wolf'",
            ".write": false
          }
        },
        "events": {
          ".read": "auth != null",
          ".write": false
        },
        ".write": false
      }
    }
  }
}